# .env – Einstellungen der Sudo-Zentrale (Datei als .env kopieren und ausfüllen)

# Öffentliche Adresse (so, wie die Sudos und dein Browser sie aufrufen)
PUBLIC_URL=https://sudo.example.com
PORT=8080

# --- Admin-Anmeldung mit Microsoft Entra ID (empfohlen) ---
# App-Registrierung: Web-Plattform, Umleitungs-URI = PUBLIC_URL + /auth/callback
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
# Wer darf in die Verwaltung? (UPNs/E-Mails, Komma-getrennt) …
ADMIN_USERS=meiko@example.de
# … oder alle Mitglieder einer Entra-Gruppe (Objekt-ID; Gruppen-Claim im Token aktivieren)
ADMIN_GROUP_ID=

# --- Notfall-Zugang mit Passwort (Hash erzeugen: docker compose run --rm zentrale npm run passwort) ---
# Ist Entra eingerichtet, gilt das Passwort nur, wenn LOCAL_LOGIN=true gesetzt ist.
ADMIN_PASSWORD=
LOCAL_LOGIN=false
# 1.14: zweiter Faktor für den Notfall-Zugang (empfohlen) – Schlüssel in der Verwaltung unter „Sicherheit & Quiz“ erzeugen
ADMIN_TOTP=
# Notfall-Zugang nur von diesen Adressen (optional, Komma-getrennt), z. B. 203.0.113.10,198.51.100.0/24
LOCAL_LOGIN_IPS=

# --- Frag Sudo über die Zentrale (Claude-API-Schlüssel, console.anthropic.com) ---
ANTHROPIC_API_KEY=

# Optional: erster Registrierungscode für die Sudos (sonst in der Verwaltung erzeugen)
FIRST_ENROLL_CODE=

# Geheimnis für Cookies (mind. 32 Zeichen; leer = wird automatisch erzeugt und im Datenordner gemerkt)
COOKIE_SECRET=
LOG_LEVEL=info

# --- 1.15: Mails des Ideen-Boards (Empfänger in der Verwaltung unter „Ideen“) ---
# smtps://benutzer:passwort@mail.example.com:465 oder smtp://benutzer:passwort@mail.example.com:587 (STARTTLS)
# Sonderzeichen im Passwort URL-kodieren (z. B. @ als %40). Leer = keine Mails, Ideen landen trotzdem in der Verwaltung.
SMTP_URL=
MAIL_FROM=
